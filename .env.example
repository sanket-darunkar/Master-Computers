# ============================================================
# Master Computer Academy — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ============================================================

# ── Backend API base URL ──────────────────────────────────────
# Development:  http://localhost:8081
# Production:   https://api.mastercomputeracademy.org
#
# In development, the Vite dev server proxies /api/* to this URL,
# so the browser never makes a cross-origin request.
#
# In production (built bundle), the browser calls this URL directly,
# so the backend MUST have CORS configured to allow the frontend origin
# (https://mastercomputeracademy.org).
VITE_API_BASE_URL=http://localhost:8081

# ── Dev proxy Origin header (development only) ────────────────
# Must match the backend's CORS_ALLOWED_ORIGIN environment variable.
# The Vite proxy rewrites the Origin header to this value so the
# backend CORS filter accepts the request during local development.
# This variable is NOT used in production builds.
CORS_ALLOWED_ORIGIN=http://localhost:5173
