# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output — never commit the build artefacts ───────────
# The production build is deployed from dist/ directly to the host,
# it must not be in version control.
dist/

# ── Environment files — NEVER commit real secrets ─────────────
.env
.env.local
.env.*.local
.env.development
.env.production
# Keep .env.example (no secrets — just variable names + comments)

# ── OS / Editor artefacts ─────────────────────────────────────
.DS_Store
Thumbs.db
*.local
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
